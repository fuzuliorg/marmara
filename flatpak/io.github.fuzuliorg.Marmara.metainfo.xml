<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.fuzuliorg.Marmara</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MPL-2.0</project_license>
  <name>Marmara Browser</name>
  <name xml:lang="tr">Marmara Tarayıcı</name>
  <developer id="io.github.fuzuliorg">
    <name>Fuzuli Initiative</name>
  </developer>
  <summary>Privacy-focused web browser for GNOME</summary>
  <description>
    <p>Marmara is a privacy-focused web browser with a GNOME look, built on LibreWolf and Firefox.
    It ships with uBlock Origin, Privacy Badger and ClearURLs, can optionally show a Terms of
    Service; Didn't Read rating in the address bar (off by default), and has simple, Adwaita-style settings.</p>
    <p>Marmara is not developed or endorsed by Mozilla or the LibreWolf project.</p>
  </description>
  <launchable type="desktop-id">io.github.fuzuliorg.Marmara.desktop</launchable>
  <url type="homepage">https://marmara.fuzuli.org</url>
  <url type="bugtracker">https://github.com/fuzuliorg/marmara/issues</url>
  <content_rating type="oars-1.1"/>
  <categories>
    <category>Network</category>
    <category>WebBrowser</category>
  </categories>
  <provides>
    <id>io.github.fuzuliorg.Marmara.desktop</id>
  </provides>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
